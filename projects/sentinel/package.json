  "repository": {
    "type": "git",
    "url": "git+https://github.com/netmexmedia/sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/netmexmedia/sentinel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./fesm2022/netmex-sentinel.mjs",
